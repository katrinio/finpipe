# Local development secret. Production injects it from Infisical prod /finpipe.
SIGNATURE_ENCRYPTION_KEY=

# Local development secret. Production injects it from Infisical prod /finpipe.
TELEGRAM_BOT_TOKEN=

# Ordinary configuration.
BOT_OWNER_TELEGRAM_ID=

# Local development database. Production injects DATABASE_URL from Infisical.
DATABASE_URL=postgresql+psycopg://finpipe:finpipe@postgres:5432/finpipe

# Test-only database. Production Compose explicitly clears TEST_DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://finpipe:finpipe@localhost:5433/finpipe_test
